{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach: Cache Service",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "restart": true,
            "timeout": 30000,
            "cwd": "${workspaceFolder}/workers/tiltify-cache",
            "resolveSourceMapLocations": null,
            "attachExistingChildren": false,
            "autoAttachChildProcesses": false
        },
        {
            "name": "Attach: Website & API",
            "type": "node",
            "request": "attach",
            "port": 9230,
            "restart": true,
            "timeout": 30000,
            "cwd": "${workspaceFolder}",
            "resolveSourceMapLocations": null,
            "attachExistingChildren": false,
            "autoAttachChildProcesses": false
        }
    ],
    "compounds": [
        {
            "name": "Debug System",
            "preLaunchTask": "Dev",
            "configurations": [
                "Attach: Cache Service",
                "Attach: Website & API"
            ],
            "stopAll": true
        },
        {
            "name": "Debug System (Clean)",
            "preLaunchTask": "Clean Dev",
            "configurations": [
                "Attach: Cache Service",
                "Attach: Website & API"
            ],
            "stopAll": true
        }
    ]
}
