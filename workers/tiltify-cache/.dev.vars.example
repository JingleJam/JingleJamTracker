# Copy to .dev.vars (gitignored). Values here override [vars] in wrangler.toml for local dev.
ADMIN_TOKEN="change-me"

# Uncomment to poll Tiltify on a timer locally. Values are strings, so only set these to enable:
# any non-empty value (even "false") is treated as true.
# ENABLE_REFRESH="true"
# ENABLE_GRAPH_REFRESH="true"

# Uncomment to serve generated demo data instead of Tiltify's, with the event about to start, under way, or about to end
# when the API is first requested. Restart `npm run dev` (or run `npm run seed`) to start the demo again.
# DEMO_MODE="starting"
