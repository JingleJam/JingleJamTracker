{
    "name": "tiltify-cache",
    "version": "1.0.0",
    "description": "Jingle Jam Tracker Caching Service",
    "main": "dist/index.js",
    "private": true,
    "scripts": {
        "dev": "wrangler dev --name tiltify-cache --persist-to ../../.wrangler/state --inspector-port 9229",
        "deploy:production": "wrangler deploy --env=\"\"",
        "deploy:development": "wrangler deploy -e development",
        "kv-causes:production": "wrangler kv key put causes --path=../../kv/causes.json --namespace-id=9d285e05684c4887acb7731de7a41a4e --remote",
        "kv-summary:production": "wrangler kv key put summary --path=../../kv/summary.json --namespace-id=9d285e05684c4887acb7731de7a41a4e --remote",
        "kv-causes:development": "wrangler kv key put causes --path=../../kv/causes.json --namespace-id=c9634f49deeb4618b3c3f1980f777f7a --remote",
        "kv-summary:development": "wrangler kv key put summary --path=../../kv/summary.json --namespace-id=c9634f49deeb4618b3c3f1980f777f7a --remote"
    }
}
