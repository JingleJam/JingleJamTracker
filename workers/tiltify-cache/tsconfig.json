{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strictNullChecks": true,
    "lib": ["es2021"],
    "types": ["@cloudflare/workers-types"],
    "rootDir": "src",
    "paths": {
      "tiltify-cache/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
